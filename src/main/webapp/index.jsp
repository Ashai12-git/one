  <div class="drawer-head"><h2><i class="fa-solid fa-bag-shopping"></i> Your cart <span class="muted" id="drawerCount"></span></h2><button class="icon-btn" id="closeCart" aria-label="Close cart"><i class="fa-solid fa-xmark"></i></button></div>
  <div class="drawer-body" id="cartItems"></div>
  <div class="drawer-foot"><div class="coupon"><input id="couponInput" placeholder="Try code SAVE10" aria-label="Coupon code"><button id="couponBtn">Apply</button></div><div class="total-line"><span>Subtotal</span><strong id="subtotal">$0.00</strong></div><div class="total-line"><span>Discount</span><strong id="discount">$0.00</strong></div><div class="total-line"><span>Shipping</span><strong id="shipping">$0.00</strong></div><div class="total-line grand"><span>Total</span><strong id="total">$0.00</strong></div><button class="btn btn-primary" id="checkoutBtn">Continue to checkout <i class="fa-solid fa-arrow-right"></i></button></div>
</aside>

<div class="modal" id="productModal" role="dialog" aria-modal="true" aria-label="Product details"><div class="modal-card"><button class="icon-btn modal-close" id="closeProductModal" aria-label="Close product details"><i class="fa-solid fa-xmark"></i></button><div id="quickView"></div></div></div>
<div class="modal" id="checkoutModal" role="dialog" aria-modal="true" aria-label="Checkout"><div class="modal-card"><button class="icon-btn modal-close" id="closeCheckout" aria-label="Close checkout"><i class="fa-solid fa-xmark"></i></button><span class="eyebrow">Almost there</span><h2 style="font-family:Manrope;margin:8px 0">Demo checkout</h2><p class="muted">This sample form demonstrates the checkout flow. It will not charge you or submit your details to a server.</p><form id="checkoutForm" class="form-grid"><label>Full name<input name="name" autocomplete="name" required placeholder="Your full name"></label><label>Email address<input name="email" type="email" autocomplete="email" required placeholder="you@example.com"></label><label>Delivery address<textarea name="address" autocomplete="street-address" required placeholder="Street, city and postal code"></textarea></label><button class="btn btn-primary" type="submit">Place demo order</button></form></div></div>
<div class="toast-stack" id="toastStack" aria-live="polite"></div>
<button class="icon-btn" id="topBtn" aria-label="Back to top"><i class="fa-solid fa-arrow-up"></i></button>

<script>
"use strict";
const PRODUCTS = [
 {id:1,name:"iPhone 14 Pro Max",category:"Smartphones",price:1099,oldPrice:1199,rating:5,reviews:128,badge:"New",image:"https://images.unsplash.com/photo-1592899677977-9c10ca588bbd?auto=format&fit=crop&w=700&q=80"},
 {id:2,name:"MacBook Pro 14",category:"Laptops",price:999,oldPrice:1199,rating:5,reviews:86,badge:"Deal",image:"https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=700&q=80"},
 {id:3,name:"Apple Watch Series 8",category:"Accessories",price:349,oldPrice:399,rating:5,reviews:214,badge:"Sale",image:"https://images.unsplash.com/photo-1546868871-7041f2a55e8f?auto=format&fit=crop&w=700&q=80"},
 {id:4,name:"Nike Air Max",category:"Footwear",price:150,rating:4,reviews:53,badge:"",image:"https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=700&q=80"},
 {id:5,name:"Sony A7 IV Camera",category:"Gadgets",price:2499,rating:5,reviews:42,badge:"New",image:"https://images.unsplash.com/photo-1516035069371-29a1b244cc32?auto=format&fit=crop&w=700&q=80"},
 {id:6,name:"Sony WH-1000XM5",category:"Gadgets",price:399,rating:5,reviews:156,badge:"",image:"https://images.unsplash.com/photo-1546435770-a3e426bf472b?auto=format&fit=crop&w=700&q=80"},
 {id:7,name:"Travel Backpack",category:"Accessories",price:79,oldPrice:99,rating:4,reviews:67,badge:"Sale",image:"https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=700&q=80"},
 {id:8,name:"Premium Hoodie",category:"Clothing",price:69,rating:4,reviews:92,badge:"",image:"https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&w=700&q=80"},
 {id:9,name:"Samsung Galaxy S24",category:"Smartphones",price:899,rating:5,reviews:145,badge:"New",image:"https://images.unsplash.com/photo-1610945265064-0e34e5519bbf?auto=format&fit=crop&w=700&q=80"},
 {id:10,name:"Mechanical Keyboard",category:"Gadgets",price:119,rating:4,reviews:77,badge:"",image:"https://images.unsplash.com/photo-1587829741301-dc798b83add3?auto=format&fit=crop&w=700&q=80"},
 {id:11,name:"Running Shoes",category:"Footwear",price:110,oldPrice:140,rating:5,reviews:118,badge:"Sale",image:"https://images.unsplash.com/photo-1551107696-a4b0c5a0d9a2?auto=format&fit=crop&w=700&q=80"},
 {id:12,name:"Classic Sunglasses",category:"Accessories",price:59,rating:4,reviews:45,badge:"",image:"https://images.unsplash.com/photo-1511499767150-a48a237f0083?auto=format&fit=crop&w=700&q=80"}
];
const CATEGORY_ICONS={Smartphones:"fa-mobile-screen-button",Laptops:"fa-laptop",Clothing:"fa-shirt",Gadgets:"fa-headphones",Footwear:"fa-shoe-prints",Accessories:"fa-glasses"};
const $=id=>document.getElementById(id);
const money=value=>new Intl.NumberFormat("en-US",{style:"currency",currency:"USD"}).format(value);
function readStorage(key,fallback){try{const value=JSON.parse(localStorage.getItem(key));return value??fallback}catch{return fallback}}
let cart=readStorage("nexusShopCart",[]).filter(x=>PRODUCTS.some(p=>p.id===Number(x.id))&&Number.isInteger(x.quantity)&&x.quantity>0);
let wishlist=readStorage("nexusShopWishlist",[]).filter(id=>PRODUCTS.some(p=>p.id===Number(id))).map(Number);
let discountCode="";
const icons={search:"fa-magnifying-glass"};
function toast(message){const node=document.createElement("div");node.className="toast";const icon=document.createElement("i");icon.className="fa-solid fa-circle-check";node.append(icon,document.createTextNode(" "+message));$("toastStack").append(node);window.setTimeout(()=>node.remove(),2800)}
function saveState(){try{localStorage.setItem("nexusShopCart",JSON.stringify(cart));localStorage.setItem("nexusShopWishlist",JSON.stringify(wishlist))}catch{toast("Browser storage is unavailable; changes may not persist.")}}
function productById(id){return PRODUCTS.find(p=>p.id===Number(id))}
function renderCategories(){
 const categories=[...new Set(PRODUCTS.map(p=>p.category))];$("categoriesGrid").replaceChildren();$("categoryFilter").replaceChildren(new Option("All categories","all"));
 categories.forEach(category=>{const count=PRODUCTS.filter(p=>p.category===category).length;const button=document.createElement("button");button.className="category";button.type="button";button.innerHTML=`<span class="category-icon"><i class="fa-solid ${CATEGORY_ICONS[category]||"fa-box"}"></i></span><strong>${category}</strong><small>${count} products</small>`;button.addEventListener("click",()=>{ $("categoryFilter").value=category;renderProducts();$("products").scrollIntoView({behavior:"smooth"})});$("categoriesGrid").append(button);$("categoryFilter").add(new Option(category,category))});
}
function renderProducts(){
 let list=[...PRODUCTS];const query=$("searchInput").value.trim().toLowerCase();const category=$("categoryFilter").value;const sort=$("sortSelect").value;
 if(query)list=list.filter(p=>(p.name+" "+p.category).toLowerCase().includes(query));
 if(category!=="all")list=list.filter(p=>p.category===category);
 if(sort==="price-low")list.sort((a,b)=>a.price-b.price);if(sort==="price-high")list.sort((a,b)=>b.price-a.price);if(sort==="rating")list.sort((a,b)=>b.rating-a.rating);if(sort==="name")list.sort((a,b)=>a.name.localeCompare(b.name));
 $("resultText").textContent=`${list.length} product${list.length===1?"":"s"} found`;
 const grid=$("productsGrid");grid.replaceChildren();
 if(!list.length){const empty=document.createElement("div");empty.className="empty-state";empty.innerHTML='<i class="fa-solid fa-magnifying-glass"></i><h3>No products found</h3><p>Try another search term or category.</p><button class="btn btn-quiet" id="resetSearch">Clear filters</button>';grid.append(empty);$("resetSearch").addEventListener("click",()=>{$("searchInput").value="";$("categoryFilter").value="all";$("sortSelect").value="default";renderProducts()});return}
 list.forEach(p=>{const card=document.createElement("article");card.className="product";const badge=p.badge?`<span class="pill ${p.badge==="Sale"||p.badge==="Deal"?"sale":""}">${p.badge}</span>`:"";const stars="★".repeat(p.rating)+"☆".repeat(5-p.rating);card.innerHTML=`<div class="product-image"><img src="${p.image}" alt="${p.name}" loading="lazy">${badge}<button class="wish-btn ${wishlist.includes(p.id)?"active":""}" data-wish="${p.id}" aria-label="${wishlist.includes(p.id)?"Remove from":"Add to"} wishlist"><i class="${wishlist.includes(p.id)?"fa-solid":"fa-regular"} fa-heart"></i></button></div><div class="product-body"><div class="product-category">${p.category}</div><h3>${p.name}</h3><div class="rating" aria-label="${p.rating} out of 5 stars">${stars}<span>(${p.reviews})</span></div><div class="price-row"><span class="price">${money(p.price)}</span>${p.oldPrice?`<span class="old-price">${money(p.oldPrice)}</span>`:""}</div><div class="product-actions"><button class="btn btn-primary" data-cart="${p.id}"><i class="fa-solid fa-plus"></i> Add to cart</button><button class="icon-btn" data-view="${p.id}" aria-label="View ${p.name}"><i class="fa-regular fa-eye"></i></button></div></div>`;grid.append(card)});
 grid.querySelectorAll("[data-cart]").forEach(b=>b.addEventListener("click",()=>addToCart(b.dataset.cart)));
 grid.querySelectorAll("[data-wish]").forEach(b=>b.addEventListener("click",()=>toggleWishlist(b.dataset.wish)));
 grid.querySelectorAll("[data-view]").forEach(b=>b.addEventListener("click",()=>openQuickView(b.dataset.view)));
}
function addToCart(id){id=Number(id);const p=productById(id);if(!p)return;const item=cart.find(x=>x.id===id);if(item)item.quantity++;else cart.push({id,quantity:1});saveState();updateCart();toast(`${p.name} added to cart`)}
function toggleWishlist(id){id=Number(id);wishlist=wishlist.includes(id)?wishlist.filter(x=>x!==id):[...wishlist,id];saveState();updateWishlist();renderProducts();toast(wishlist.includes(id)?"Added to wishlist":"Removed from wishlist")}
function updateWishlist(){$("wishlistCount").textContent=wishlist.length;$("wishlistBtn").setAttribute("aria-label",`Show wishlist, ${wishlist.length} items`)}
function updateCart(){
 const root=$("cartItems");root.replaceChildren();let subtotal=0;let itemCount=0;
 if(!cart.length){const empty=document.createElement("div");empty.className="empty-state";empty.innerHTML='<i class="fa-solid fa-bag-shopping"></i><h3>Your cart is waiting</h3><p>Add something you love and it will show up here.</p>';root.append(empty)}
 cart.forEach(item=>{const p=productById(item.id);if(!p)return;subtotal+=p.price*item.quantity;itemCount+=item.quantity;const row=document.createElement("div");row.className="cart-item";row.innerHTML=`<img src="${p.image}" alt="${p.name}"><div><h4>${p.name}</h4><div class="muted">${money(p.price)} each</div><div class="qty"><button data-minus="${p.id}" aria-label="Decrease quantity">−</button><span>${item.quantity}</span><button data-plus="${p.id}" aria-label="Increase quantity">+</button></div></div><button class="remove-btn" data-remove="${p.id}" aria-label="Remove ${p.name}"><i class="fa-regular fa-trash-can"></i></button>`;root.append(row)});
 root.querySelectorAll("[data-minus]").forEach(b=>b.addEventListener("click",()=>changeQuantity(b.dataset.minus,-1)));root.querySelectorAll("[data-plus]").forEach(b=>b.addEventListener("click",()=>changeQuantity(b.dataset.plus,1)));root.querySelectorAll("[data-remove]").forEach(b=>b.addEventListener("click",()=>removeFromCart(b.dataset.remove)));
 const discount=discountCode==="SAVE10"?subtotal*.1:0;const shipping=subtotal===0||subtotal>=100?0:9.99;const total=Math.max(0,subtotal-discount+shipping);
 $("cartCount").textContent=itemCount;$("drawerCount").textContent=itemCount?`(${itemCount})`:"";$("subtotal").textContent=money(subtotal);$("discount").textContent="-"+money(discount);$("shipping").textContent=money(shipping);$("total").textContent=money(total);$("couponInput").value=discountCode;
 $("checkoutBtn").disabled=!cart.length;$("checkoutBtn").style.opacity=cart.length?"1":".55";
}
function changeQuantity(id,change){const item=cart.find(x=>x.id===Number(id));if(!item)return;item.quantity+=change;if(item.quantity<=0)cart=cart.filter(x=>x.id!==Number(id));saveState();updateCart()}
function removeFromCart(id){cart=cart.filter(x=>x.id!==Number(id));saveState();updateCart();toast("Item removed from cart")}
function openDrawer(){ $("overlay").classList.add("show");$("cartDrawer").classList.add("open");document.body.style.overflow="hidden";$("closeCart").focus()}
function closeDrawer(){ $("overlay").classList.remove("show");$("cartDrawer").classList.remove("open");document.body.style.overflow=""}
function openQuickView(id){const p=productById(id);if(!p)return;const root=$("quickView");root.innerHTML=`<div class="quick-view"><img src="${p.image}" alt="${p.name}"><div><span class="eyebrow">${p.category}</span><h2>${p.name}</h2><div class="rating">${"★".repeat(p.rating)}${"☆".repeat(5-p.rating)} <span>(${p.reviews} reviews)</span></div><p class="muted">A carefully selected everyday essential with a balance of design, quality and useful features.</p><div class="price-row"><span class="price">${money(p.price)}</span>${p.oldPrice?`<span class="old-price">${money(p.oldPrice)}</span>`:""}</div><button class="btn btn-primary" id="quickAdd"><i class="fa-solid fa-cart-plus"></i> Add to cart</button> <button class="btn btn-outline" id="quickWish"><i class="fa-regular fa-heart"></i> Wishlist</button></div></div>`;$("productModal").classList.add("show");$("quickAdd").addEventListener("click",()=>{addToCart(p.id);$("productModal").classList.remove("show")});$("quickWish").addEventListener("click",()=>toggleWishlist(p.id))}
function openCheckout(){if(!cart.length){toast("Your cart is empty");return}closeDrawer();$("checkoutModal").classList.add("show")}
function closeModals(){$("productModal").classList.remove("show");$("checkoutModal").classList.remove("show")}
$("cartBtn").addEventListener("click",openDrawer);$("closeCart").addEventListener("click",closeDrawer);$("overlay").addEventListener("click",closeDrawer);
$("searchInput").addEventListener("input",renderProducts);$("categoryFilter").addEventListener("change",renderProducts);$("sortSelect").addEventListener("change",renderProducts);
$("allCategoriesBtn").addEventListener("click",()=>{$("categoryFilter").value="all";$("searchInput").value="";renderProducts();$("products").scrollIntoView({behavior:"smooth"})});
$("wishlistBtn").addEventListener("click",()=>{const ids=wishlist.map(productById).filter(Boolean);if(!ids.length){toast("Your wishlist is empty");return}const first=ids[0];$("searchInput").value="";$("categoryFilter").value="all";renderProducts();$("resultText").textContent=`Your wishlist has ${ids.length} item${ids.length===1?"":"s"}`;const cards=[...$("productsGrid").querySelectorAll(".product")];cards.forEach(card=>{const b=card.querySelector("[data-wish]");if(b&&!wishlist.includes(Number(b.dataset.wish)))card.remove()});$("products").scrollIntoView({behavior:"smooth"})});
$("themeBtn").addEventListener("click",()=>{document.body.classList.toggle("dark");const dark=document.body.classList.contains("dark");$("themeBtn").innerHTML=`<i class="fa-solid ${dark?"fa-sun":"fa-moon"}"></i>`;$("themeBtn").setAttribute("aria-label",dark?"Switch to light mode":"Switch to dark mode");try{localStorage.setItem("nexusShopTheme",dark?"dark":"light")}catch{}});
try{if(localStorage.getItem("nexusShopTheme")==="dark"){document.body.classList.add("dark");$("themeBtn").innerHTML='<i class="fa-solid fa-sun"></i>'}}catch{}
$("menuBtn").addEventListener("click",()=>{const open=$("mobileNav").classList.toggle("show");$("menuBtn").setAttribute("aria-expanded",String(open));$("menuBtn").innerHTML=`<i class="fa-solid ${open?"fa-xmark":"fa-bars"}"></i>`});
$("mobileNav").querySelectorAll("a").forEach(a=>a.addEventListener("click",()=>{$("mobileNav").classList.remove("show");$("menuBtn").setAttribute("aria-expanded","false");$("menuBtn").innerHTML='<i class="fa-solid fa-bars"></i>'}));
$("couponBtn").addEventListener("click",()=>{const code=$("couponInput").value.trim().toUpperCase();if(code==="SAVE10"){discountCode=code;updateCart();toast("10% discount applied")}else{discountCode="";updateCart();toast("Code not recognised. Try SAVE10")}});
$("checkoutBtn").addEventListener("click",openCheckout);$("closeCheckout").addEventListener("click",closeModals);$("closeProductModal").addEventListener("click",closeModals);
$("productModal").addEventListener("click",e=>{if(e.target===$("productModal"))closeModals()});$("checkoutModal").addEventListener("click",e=>{if(e.target===$("checkoutModal"))closeModals()});
$("checkoutForm").addEventListener("submit",e=>{e.preventDefault();if(!cart.length){closeModals();toast("Your cart is empty");return}const orderId="NX-"+Math.random().toString(36).slice(2,8).toUpperCase();cart=[];discountCode="";saveState();updateCart();closeModals();e.target.reset();toast(`Demo order ${orderId} created — no payment taken`)});
$("newsletterForm").addEventListener("submit",e=>{e.preventDefault();toast("Thanks for subscribing! This is a demo form.");e.target.reset()});
$("dealCartBtn").addEventListener("click",()=>addToCart(2));
document.addEventListener("keydown",e=>{if(e.key==="Escape"){closeDrawer();closeModals()}if(e.key==="/"&&!["INPUT","TEXTAREA"].includes(document.activeElement.tagName)){e.preventDefault();$("searchInput").focus()}});
const topBtn=$("topBtn");window.addEventListener("scroll",()=>{topBtn.style.display=window.scrollY>500?"grid":"none"});topBtn.addEventListener("click",()=>window.scrollTo({top:0,behavior:"smooth"}));
$("year").textContent=new Date().getFullYear();
const dealEnd=Date.now()+24*60*60*1000;function updateTimer(){let secondsLeft=Math.max(0,Math.floor((dealEnd-Date.now())/1000));$("days").textContent=String(Math.floor(secondsLeft/86400)).padStart(2,"0");$("hours").textContent=String(Math.floor(secondsLeft%86400/3600)).padStart(2,"0");$("minutes").textContent=String(Math.floor(secondsLeft%3600/60)).padStart(2,"0");$("seconds").textContent=String(secondsLeft%60).padStart(2,"0")}updateTimer();window.setInterval(updateTimer,1000);
renderCategories();renderProducts();updateCart();updateWishlist();
</script>
</body>
</html>
