<style>
:root{color-scheme:light;--bg:#f7f8fc;--surface:#fff;--text:#171923;--muted:#70758a;--line:#e7e9f1;--brand:#635bff;--brand2:#4e46df;--soft:#efeeff;--green:#078c68;--red:#d9435f;--shadow:0 16px 45px rgba(24,28,54,.09);--radius:20px}
