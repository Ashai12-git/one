*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:90px}body{margin:0;background:var(--bg);color:var(--text);font-family:"DM Sans",sans-serif;line-height:1.55;transition:background .2s,color .2s}button,input,select,textarea{font:inherit}button{cursor:pointer}button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #a6a1ff;outline-offset:3px}a{color:inherit;text-decoration:none}img{display:block;max-width:100%}.container{width:min(1180px,92%);margin:auto}.eyebrow{font-size:.75rem;letter-spacing:.13em;text-transform:uppercase;font-weight:800;color:var(--brand)}.muted{color:var(--muted)}.btn{border:0;border-radius:12px;padding:12px 18px;font-weight:700;display:inline-flex;align-items:center;justify-content:center;gap:9px;transition:transform .2s,background .2s}.btn:hover{transform:translateY(-2px)}.btn-primary{background:var(--brand);color:#fff}.btn-primary:hover{background:var(--brand2)}.btn-quiet{background:var(--soft);color:var(--brand)}.btn-outline{border:1px solid var(--line);background:transparent;color:var(--text)}.icon-btn{width:42px;height:42px;border:1px solid var(--line);border-radius:13px;background:var(--surface);color:var(--text);display:grid;place-items:center;position:relative}.icon-btn:hover{border-color:var(--brand);color:var(--brand)}.count{position:absolute;right:-5px;top:-6px;min-width:19px;height:19px;padding:0 4px;border-radius:20px;background:var(--brand);color:#fff;font-size:.68rem;display:grid;place-items:center;border:2px solid var(--surface)}
header{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--surface) 90%,transparent);backdrop-filter:blur(16px);border-bottom:1px solid var(--line)}.header-row{min-height:76px;display:flex;align-items:center;gap:28px}.logo{font-family:Manrope,sans-serif;font-size:1.45rem;font-weight:800;letter-spacing:-.06em;white-space:nowrap}.logo-mark{display:inline-grid;place-items:center;width:33px;height:33px;border-radius:11px;background:var(--brand);color:white;margin-right:8px;font-size:.95rem}.logo span{color:var(--brand)}nav{margin-right:auto}nav ul{display:flex;list-style:none;gap:23px;padding:0;margin:0}nav a{font-size:.91rem;font-weight:700;color:var(--muted)}nav a:hover,nav a.active{color:var(--brand)}.header-actions{display:flex;gap:9px;align-items:center}.search{height:43px;width:220px;display:flex;align-items:center;gap:9px;padding:0 12px;border:1px solid var(--line);border-radius:13px;background:var(--bg);color:var(--muted)}.search input{width:100%;min-width:0;border:0;outline:0;background:transparent;color:var(--text)}.menu-btn{display:none}.mobile-nav{display:none;padding:0 0 16px}.mobile-nav.show{display:grid;gap:10px}.mobile-nav a{padding:9px 0;color:var(--muted);font-weight:700}
.hero{padding:35px 0 18px}.hero-panel{position:relative;isolation:isolate;overflow:hidden;min-height:475px;border-radius:30px;background:#191b2c;color:#fff;display:flex;align-items:center;padding:clamp(28px,6vw,72px)}.hero-panel:before{content:"";position:absolute;inset:0;z-index:-2;background:url("https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=1800&q=85") center/cover}.hero-panel:after{content:"";position:absolute;inset:0;z-index:-1;background:linear-gradient(90deg,rgba(13,15,28,.94),rgba(13,15,28,.68) 48%,rgba(13,15,28,.1))}.hero-copy{max-width:600px}.hero-tag{display:inline-flex;gap:8px;align-items:center;border:1px solid #ffffff40;background:#ffffff15;border-radius:40px;padding:8px 13px;font-size:.82rem;font-weight:700}.hero h1{font:800 clamp(2.6rem,6vw,4.7rem)/1.04 Manrope,sans-serif;letter-spacing:-.06em;margin:22px 0 18px}.hero h1 em{font-style:normal;color:#b7b2ff}.hero p{max-width:500px;color:#e0e1ec;font-size:1.05rem}.hero-buttons{display:flex;gap:12px;flex-wrap:wrap;margin-top:27px}.hero .btn-outline{color:#fff;border-color:#ffffff70}.hero-foot{display:flex;gap:22px;flex-wrap:wrap;margin-top:28px;color:#e0e1ec;font-size:.84rem}.hero-foot i{color:#b7b2ff;margin-right:6px}
.benefits{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;padding:22px 0 10px}.benefit{display:flex;align-items:center;gap:13px;background:var(--surface);border:1px solid var(--line);padding:17px;border-radius:16px}.benefit-icon{width:43px;height:43px;flex:none;display:grid;place-items:center;background:var(--soft);color:var(--brand);border-radius:13px}.benefit strong{display:block;font-size:.91rem}.benefit small{color:var(--muted)}
.section{padding:54px 0}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:24px}.section-head h2{font:800 clamp(1.7rem,3vw,2.25rem)/1.15 Manrope,sans-serif;letter-spacing:-.045em;margin:7px 0}.section-head p{margin:0;color:var(--muted)}.text-link{border:0;background:transparent;color:var(--brand);font-weight:800}.categories{display:grid;grid-template-columns:repeat(6,1fr);gap:13px}.category{border:1px solid var(--line);border-radius:18px;background:var(--surface);padding:20px 10px;text-align:center;transition:.2s;color:var(--text)}.category:hover,.category.active{transform:translateY(-4px);border-color:var(--brand);box-shadow:var(--shadow)}.category-icon{width:54px;height:54px;display:grid;place-items:center;border-radius:17px;margin:0 auto 12px;background:var(--soft);color:var(--brand);font-size:1.3rem}.category strong{display:block;font-size:.9rem}.category small{color:var(--muted)}
