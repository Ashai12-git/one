.deal{display:grid;grid-template-columns:1fr 1fr;border-radius:26px;overflow:hidden;background:#1c2034;color:white}.deal-image{min-height:350px;background:url("https://images.unsplash.com/photo-1517336714731-489689fd1ca8?auto=format&fit=crop&w=1000&q=85") center/cover}.deal-copy{padding:clamp(25px,5vw,55px);display:flex;flex-direction:column;justify-content:center}.deal-copy h2{font:800 clamp(2rem,4vw,3rem)/1.08 Manrope,sans-serif;letter-spacing:-.05em;margin:15px 0}.deal-copy p{color:#d4d7e5}.deal-price{font-size:1.8rem;font-weight:800;margin-top:8px}.deal-price del{font-size:1rem;color:#aeb3c8;margin-left:8px}.timer{display:flex;gap:9px;margin:20px 0}.timer-box{min-width:58px;padding:9px 8px;border-radius:11px;background:#ffffff13;text-align:center}.timer-box strong{display:block;font-size:1.25rem}.timer-box small{color:#c3c7d7;font-size:.7rem}
.newsletter{display:flex;align-items:center;justify-content:space-between;gap:25px;padding:clamp(25px,5vw,45px);border-radius:24px;background:linear-gradient(120deg,#635bff,#877fff);color:#fff}.newsletter h2{font:800 clamp(1.7rem,3vw,2.2rem) Manrope;margin:0 0 6px}.newsletter p{margin:0;color:#e8e7ff}.newsletter-form{display:flex;gap:8px;width:min(440px,100%)}.newsletter-form input{min-width:0;flex:1;border:0;border-radius:11px;padding:13px 14px}.newsletter-form button{background:#fff;color:#4e46df;border:0;border-radius:11px;padding:0 18px;font-weight:800}
footer{margin-top:25px;background:#151725;color:#fff;padding:48px 0 20px}.footer-grid{display:grid;grid-template-columns:2fr repeat(3,1fr);gap:32px}.footer-grid p,.footer-grid a{color:#aeb2c4;font-size:.9rem}.footer-grid h4{margin:0 0 14px}.footer-grid ul{list-style:none;padding:0;margin:0}.footer-grid li{margin:9px 0}.socials{display:flex;gap:9px;margin-top:18px}.socials a{width:36px;height:36px;border-radius:50%;background:#272a3c;display:grid;place-items:center;color:white}.footer-bottom{border-top:1px solid #33364a;margin-top:32px;padding-top:18px;text-align:center;color:#aeb2c4;font-size:.82rem}
.overlay{position:fixed;inset:0;z-index:90;background:#090b17a6;opacity:0;pointer-events:none;transition:opacity .25s}.overlay.show{opacity:1;pointer-events:auto}.drawer{position:fixed;z-index:100;top:0;right:0;height:100dvh;width:min(440px,100%);background:var(--surface);transform:translateX(102%);transition:transform .28s;display:flex;flex-direction:column;box-shadow:var(--shadow)}.drawer.open{transform:translateX(0)}.drawer-head{padding:20px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between}.drawer-head h2{font:800 1.25rem Manrope;margin:0}.drawer-body{padding:18px;overflow:auto;flex:1}.drawer-foot{border-top:1px solid var(--line);padding:18px}.cart-item{display:grid;grid-template-columns:72px 1fr auto;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}.cart-item img{width:72px;height:72px;border-radius:12px;object-fit:cover}.cart-item h4{margin:0 0 5px;font-size:.9rem}.cart-item .muted{font-size:.8rem}.qty{display:flex;align-items:center;gap:8px;margin-top:8px}.qty button{width:26px;height:26px;border:1px solid var(--line);border-radius:7px;background:var(--bg);color:var(--text)}.remove-btn{border:0;background:transparent;color:var(--red)}.coupon{display:flex;margin-bottom:14px}.coupon input{min-width:0;flex:1;border:1px solid var(--line);border-radius:9px 0 0 9px;padding:10px;background:var(--bg);color:var(--text)}.coupon button{border:0;border-radius:0 9px 9px 0;background:var(--brand);color:white;padding:0 14px;font-weight:700}.total-line{display:flex;justify-content:space-between;margin:8px 0}.total-line.grand{font-size:1.15rem;font-weight:800;border-top:1px solid var(--line);padding-top:12px;margin-top:12px}.drawer-foot .btn{width:100%;margin-top:10px}
.modal{position:fixed;z-index:120;inset:0;display:none;place-items:center;padding:20px;background:#090b17b8}.modal.show{display:grid}.modal-card{position:relative;width:min(760px,100%);max-height:90dvh;overflow:auto;background:var(--surface);border:1px solid var(--line);border-radius:22px;padding:26px}.modal-close{position:absolute;top:14px;right:14px;z-index:2}.quick-view{display:grid;grid-template-columns:1fr 1fr;gap:25px;align-items:center}.quick-view img{width:100%;max-height:400px;object-fit:cover;border-radius:15px}.quick-view h2{font:800 1.8rem Manrope;line-height:1.15}.quick-view .price{font-size:1.6rem}.form-grid{display:grid;gap:13px}.form-grid label{display:grid;gap:6px;font-weight:700;font-size:.9rem}.form-grid input,.form-grid textarea{width:100%;padding:12px;border:1px solid var(--line);border-radius:10px;background:var(--bg);color:var(--text)}.form-grid textarea{min-height:90px;resize:vertical}.toast-stack{position:fixed;right:18px;bottom:18px;z-index:200;display:grid;gap:9px}.toast{background:#171923;color:white;padding:13px 16px;border-radius:12px;box-shadow:var(--shadow);max-width:min(360px,90vw);animation:slide .2s ease}.toast i{color:#a9f0d5;margin-right:7px}@keyframes slide{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}#topBtn{position:fixed;left:20px;bottom:20px;z-index:40;display:none}
@media(max-width:1000px){nav ul{gap:14px}.search{width:180px}.categories{grid-template-columns:repeat(3,1fr)}.product-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.product-image{height:205px}}
@media(max-width:800px){nav,.search{display:none}.menu-btn{display:grid}.header-row{gap:12px}.logo{margin-right:auto}.benefits{grid-template-columns:1fr}.deal{grid-template-columns:1fr}.deal-image{min-height:280px}.newsletter{align-items:flex-start;flex-direction:column}.newsletter-form{max-width:100%}.footer-grid{grid-template-columns:1fr 1fr}}
@media(max-width:560px){.header-row{min-height:66px}.hero{padding-top:18px}.hero-panel{min-height:440px;border-radius:22px;padding:25px}.hero h1{font-size:2.65rem}.hero-foot{gap:10px;display:grid}.section{padding:38px 0}.section-head{align-items:flex-start;flex-direction:column}.categories{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.category{padding:16px 8px}.product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.product-image{height:160px}.product-body{padding:11px}.product h3{font-size:.9rem}.product-actions{grid-template-columns:1fr 38px}.product-actions .btn{font-size:.75rem;padding:9px 4px}.controls{width:100%}.select{flex:1;min-width:0}.deal-image{min-height:220px}.timer{gap:6px}.timer-box{min-width:0;flex:1}.newsletter-form{flex-direction:column}.newsletter-form button{padding:12px}.footer-grid{grid-template-columns:1fr}.quick-view{grid-template-columns:1fr}.quick-view img{max-height:260px}.modal-card{padding:22px 17px}.cart-item{grid-template-columns:60px 1fr auto}.cart-item img{width:60px;height:60px}}
